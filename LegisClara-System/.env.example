# LegisClara - Variáveis de Ambiente

# ============================================================================
# OBRIGATÓRIO
# ============================================================================

# Google Gemini API (Gratuito - 1500 requisições/dia)
# Obtenha em: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================================================
# OPCIONAL - Publicação Automática no Instagram
# ============================================================================

# Instagram Graph API
# Tutorial: https://developers.facebook.com/docs/instagram-api/getting-started
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here
INSTAGRAM_USER_ID=your_instagram_user_id_here

# Notas:
# - Se não configurar Instagram, vídeos serão apenas salvos localmente
# - Access Token expira a cada 60 dias (precisa renovar)
# - User ID é o ID do seu perfil business/creator no Instagram
