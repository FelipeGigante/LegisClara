    {
      "parameters": {
        "jsCode": "// Aguardar processamento do vídeo D-ID\nconst videoId = $json.id;\nconst apiKey = $env.DID_API_KEY;\n\nasync function checkVideoStatus(id, key) {\n  const maxAttempts = 30;\n  const delayMs = 10000; // 10 segundos\n  \n  for (let i = 0; i < maxAttempts; i++) {\n    const response = await fetch(`https://api.d-id.com/talks/${id}`, {\n      headers: {\n        'Authorization': `Basic ${key}`\n      }\n    });\n    \n    const data = await response.json();\n    \n    if (data.status === 'done') {\n      return { json: { ...data, video_pronto: true } };\n    } else if (data.status === 'error') {\n      throw new Error(`Erro no D-ID: ${data.error}`);\n    }\n    \n    // Aguardar antes da próxima tentativa\n    await new Promise(resolve => setTimeout(resolve, delayMs));\n  }\n  \n  throw new Error('Timeout aguardando vídeo');\n}\n\nreturn await checkVideoStatus(videoId, apiKey);"
      },
