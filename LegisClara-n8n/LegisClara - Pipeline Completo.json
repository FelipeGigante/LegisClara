      "parameters": {
        "jsCode": "// Gerar caption otimizada para Instagram\nconst items = $input.all();\nconst result = [];\n\nfor (const item of items) {\n  const analise = item.json.analise_ia;\n  const leg = item.json;\n  \n  const caption = `🏛️ ${leg.tipo} ${leg.numero}/${leg.ano}\n\n${analise.resumo_simples}\n\n👥 Quem é impactado:\n${analise.grupos_impactados.map((g, i) => `${i+1}. ${g}`).join('\\n')}\n\n💬 ${analise.pergunta_engajadora}\n\n#LegisClara #Política #Cidadania #${leg.tipo}${leg.numero} #Brasil #Democracia #EducaçãoPolítica`;\n\n  result.push({\n    json: {\n      ...item.json,\n      caption_instagram: caption,\n      hashtags: ['LegisClara', 'Política', 'Cidadania', 'Brasil', 'Democracia']\n    }\n  });\n}\n\nreturn result;"
      },
