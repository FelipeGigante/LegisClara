      "id": "45e717d6-23a2-4a8b-8e5e-fc645a8ec4f6",
      "name": "3. Coletar Câmara",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1632,
        272
      ],
      "notes": "Coleta legislações da Câmara"
    },
    {
      "parameters": {
        "jsCode": "const proposicoes = $json.dados || [];\n  const legislacoes = [];\n\n  for (const prop of proposicoes.slice(0, 1)) {\n    legislacoes.push({\n      json: {\n        fonte: 'camara',\n        tipo: prop.siglaTipo,\n        numero: prop.numero,\n        ano: prop.ano,\n        ementa: prop.ementa,\n        data_apresentacao: prop.dataApresentacao,\n        url: `https://www.camara.leg.br/proposicoesWeb/fichadetramitacao?idProposicao=${prop.id}`,\n        id_origem: prop.id,\n        autor: prop.uriAutores || 'N/A'\n      }\n    });\n  }\n\n  return legislacoes;"
      },
      "id": "6d762414-de17-49dc-8a45-856a6d188d67",
      "name": "5. Normalizar Dados",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1904,
        272
      ],
      "notes": "Normaliza estrutura dos dados"
    },
    {
      "parameters": {
        "jsCode": "// Extrair JSON da resposta do Gemini\nconst items = $input.all();\nconst processados = [];\n\nfor (const item of items) {\n  try {\n    // Resposta do Gemini vem em candidates[0].content.parts[0].text\n    let responseText;\n    \n    if (item.json.candidates && item.json.candidates[0]) {\n      // Formato Gemini\n      responseText = item.json.candidates[0].content.parts[0].text;\n    } else {\n      // Fallback para outros formatos\n      responseText = item.json.response || item.json.output || item.json.text;\n    }\n    \n    console.log('Response text:', responseText);\n    \n    // Extrair JSON da resposta (procurar entre ```json e ```)\n    const jsonMatch = responseText.match(/```json\\s*([\\s\\S]*?)\\s*```/);\n    const jsonStr = jsonMatch ? jsonMatch[1] : responseText;\n    \n    // Tentar parsear JSON\n    const analise = JSON.parse(jsonStr);\n    \n    processados.push({\n      json: {\n        ...item.json,\n        analise_ia: analise,\n        processado_em: new Date().toISOString()\n      }\n    });\n  } catch (error) {\n    console.error('Erro ao processar resposta:', error);\n    console.error('Item completo:', JSON.stringify(item.json, null, 2));\n    \n    processados.push({\n      json: {\n        ...item.json,\n        erro_processamento: error.message,\n        resposta_bruta: item.json\n      }\n    });\n  }\n}\n\nreturn processados;"
      },
