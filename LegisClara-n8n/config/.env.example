# ============================================
# LEGISCLARA N8N - VARIÁVEIS DE AMBIENTE
# ============================================
# Copie este arquivo para .env e preencha com suas credenciais

# ============================================
# 1. GOOGLE GEMINI (GRÁTIS!) 🎉
# ============================================
# Obter em: https://aistudio.google.com/app/apikey
# GRÁTIS: 60 requisições/minuto (sem custo!)
# Alternativa ao OpenAI (que é pago)
GEMINI_API_KEY=AIza...

# ============================================
# 1B. OPENAI (ChatGPT) - OPCIONAL
# ============================================
# Se preferir usar OpenAI em vez de Gemini
# Obter em: https://platform.openai.com/api-keys
# Custo: ~$15-30/mês para 100 legislações
# OPENAI_API_KEY=sk-...

# ============================================
# 2. ELEVENLABS (Text-to-Speech)
# ============================================
# Obter em: https://elevenlabs.io/app/settings/api-keys
# Plano gratuito: 10.000 caracteres/mês
ELEVENLABS_API_KEY=...

# ID da voz (Português BR)
# Rachel (Feminina): 21m00Tcm4TlvDq8ikWAM
# Adam (Masculina): pNInz6obpgDQGcFmaJgB
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ============================================
# 3. D-ID (Avatar Vídeo) - TEM CRÉDITOS GRÁTIS!
# ============================================
# Obter em: https://studio.d-id.com/account/api-keys
# Trial: 14 dias grátis com créditos para ~20-50 vídeos
DID_API_KEY=...

# URL do avatar (use o padrão ou faça upload do seu)
DID_AVATAR_URL=https://create-images-results.d-id.com/google-oauth2%7C103908445571603294059/upl_JRxp-Y0tgdoEuHqvlmxnv/image.png

# ============================================
# 4. SUPABASE (Storage + Banco de Dados)
# ============================================
# Criar projeto em: https://supabase.com
# Plano gratuito: 500MB storage + 500MB banco
SUPABASE_PROJECT_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Nome do bucket de vídeos (criar manualmente no Supabase)
SUPABASE_BUCKET_NAME=videos

# ============================================
# 5. INSTAGRAM BUSINESS API
# ============================================
# Setup: https://developers.facebook.com/docs/instagram-api/getting-started
# Requer: Facebook Developer Account + Instagram Business Account

# Facebook App ID
INSTAGRAM_APP_ID=...
INSTAGRAM_APP_SECRET=...

# Instagram Business Account ID
INSTAGRAM_USER_ID=...

# Access Token (renovar a cada 60 dias)
INSTAGRAM_ACCESS_TOKEN=...

# ============================================
# 6. EMAIL (SMTP) - Opcional
# ============================================
# Para Gmail: Use senha de app (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-de-app

# Destinatários (separados por vírgula)
EMAIL_PARLAMENTARES=deputado@camara.leg.br,senador@senado.leg.br

# ============================================
# 7. NOTIFICAÇÕES (Opcional)
# ============================================

# Discord Webhook (criar em: Server Settings → Integrations → Webhooks)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Slack Webhook (criar em: https://api.slack.com/messaging/webhooks)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# ============================================
# 8. CONFIGURAÇÕES DO WORKFLOW
# ============================================

# Quantas legislações processar por execução (max: 10)
MAX_LEGISLACOES_POR_DIA=5

# Intervalo de dias para buscar legislações (padrão: 7)
DIAS_RETROATIVOS=7

# Tipos de legislação para processar (separados por vírgula)
# Opções: PEC, PL, PLP, MP, PDL
TIPOS_PERMITIDOS=PEC,PL,MP

# ============================================
# 9. N8N (se self-hosted)
# ============================================

# Timezone
GENERIC_TIMEZONE=America/Sao_Paulo

# Webhook URL (se usar triggers externos)
N8N_WEBHOOK_URL=https://seu-n8n.app.n8n.cloud/webhook/...

# Encryption key (gere com: openssl rand -hex 32)
N8N_ENCRYPTION_KEY=...

# ============================================
# 10. AMBIENTE
# ============================================

# development | production
NODE_ENV=production

# Nível de log: error | warn | info | debug
LOG_LEVEL=info

# ============================================
# NOTAS IMPORTANTES
# ============================================
#
# 1. NUNCA commite o arquivo .env no Git!
#    Adicione .env ao .gitignore
#
# 2. No n8n Cloud, configure variáveis em:
#    Settings → Environment Variables
#
# 3. No n8n Self-Hosted (Docker), passe via -e:
#    docker run -e OPENAI_API_KEY=sk-... n8nio/n8n
#
# 4. Para Base64 do D-ID:
#    echo -n "sua-api-key:" | base64
#
# 5. Tokens Instagram expiram a cada 60 dias
#    Configure lembrete para renovar!
#
# ============================================
